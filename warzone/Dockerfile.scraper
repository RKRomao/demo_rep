FROM python:3.11-slim

WORKDIR /app

COPY scraper/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY scraper/ ./

ENV DB_HOST=db
ENV DB_PORT=3306
ENV DB_USER=root
ENV DB_PASSWORD=root
ENV DB_NAME=warzone_db
ENV SCRAPER_INTERVAL_SECONDS=300

CMD ["python", "main.py"]
